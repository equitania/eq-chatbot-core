# =============================================================================
# eq_chatbot_core Test Configuration
# =============================================================================
# This file holds SECRETS and BEHAVIOR FLAGS only.
#
# Test models are managed in tests/model_registry.py (versioned, with primary
# + fallback chains). The resolver in conftest.py validates the registry
# primary live against each provider's list_models() and walks the fallback
# chain on deprecation. The Markdown test report's "Models In Use" section
# shows exactly which model was used per run.
#
# IMPORTANT: Copy this file to tests/.env.test and fill in your keys.
# tests/.env.test is gitignored.

# =============================================================================
# Cloud Provider API Keys
# =============================================================================

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# LangDock — https://app.langdock.com/settings/api-keys
LANGDOCK_API_KEY=ld-...

# Mammouth AI — https://mammouth.ai
MAMMOUTH_API_KEY=mm-...

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenRouter attribution headers (visible in OpenRouter analytics)
# OPENROUTER_SITE_URL=https://your-app.example.com
# OPENROUTER_SITE_NAME=eq_chatbot_core

# Azure AI — https://ai.azure.com/
AZURE_API_KEY=...
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com/

# LiteLLM / OpenAI-compatible gateway — base_url is REQUIRED (no default endpoint).
# Works with any LiteLLM proxy, vLLM, or custom OpenAI-compatible endpoint.
LITELLM_API_KEY=...
LITELLM_BASE_URL=https://api.ccsio.ai/v1
# Optional override of the registry primary (tests/model_registry.py):
# LITELLM_TEST_MODEL=qwen3.6-35b-a3b

# Google Vertex AI — auth via gcloud Application Default Credentials.
# Run once: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=europe-west1

# =============================================================================
# Local LLM Server URLs
# =============================================================================

# LM Studio — https://lmstudio.ai/
LM_STUDIO_URL=http://localhost:1234/v1

# Ollama — https://ollama.ai/
OLLAMA_URL=http://localhost:11434/v1

# =============================================================================
# Test Behavior
# =============================================================================

# Skip live API tests entirely (useful for CI without API keys).
SKIP_LIVE_TESTS=false

# Skip local server tests when no LM Studio / Ollama is running.
SKIP_LOCAL_TESTS=true

# =============================================================================
# Optional: Ad-hoc Model Overrides
# =============================================================================
# These override the registry primary in tests/model_registry.py for a single
# debug session. The registry's fallback chain still applies if the override
# is unavailable. Prefer editing the registry over committing changes here.
#
# OPENAI_TEST_MODEL=gpt-4o
# ANTHROPIC_TEST_MODEL=claude-3-5-sonnet-20241022
# LANGDOCK_TEST_MODEL=gpt-5.4-mini
# LANGDOCK_ANTHROPIC_TEST_MODEL=claude-opus-4-7-default
# OPENROUTER_TEST_MODEL=openai/gpt-4o-mini
# MAMMOUTH_TEST_MODEL=gpt-4.1-mini
# AZURE_TEST_MODEL=gpt-4o
# VERTEX_TEST_MODEL=gemini-2.5-pro
# LOCAL_TEST_MODEL=nvidia/nemotron-3-nano