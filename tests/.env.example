# ---------------------------------------------------------------------------
# Superseded in 3.1.0 — kept as a signpost
# ---------------------------------------------------------------------------
# This file used to be copied to tests/.env.test and filled with API keys, which
# put production credentials inside the repository, protected by nothing but a
# .gitignore line.
#
# Credentials now live in the user config file, outside every git repository —
# the same file the CLI and the library already read:
#
#     eq-chatbot config init          # creates ~/.config/eq-chatbot/config.toml
#     $EDITOR ~/.config/eq-chatbot/config.toml
#     chmod 600 ~/.config/eq-chatbot/config.toml
#
#     [providers.openai]
#     api_key = "sk-..."
#
#     [providers.melious]
#     api_key = "..."
#
# conftest.py mirrors [providers.<name>].api_key into <NAME>_API_KEY and
# .base_url into <NAME>_BASE_URL (exceptions predating the convention:
# lm_studio -> LM_STUDIO_URL, ollama -> OLLAMA_URL). A real environment variable
# always wins, so CI can inject secrets without any file at all.
#
# NOT secrets, and therefore NOT in that file — these default in code and are
# overridden from the environment:
#
#     SKIP_LIVE_TESTS=true            # skip integration tests (default false)
#     SKIP_LOCAL_TESTS=true           # skip local server tests (default false)
#     <PROVIDER>_TEST_MODEL=...       # defaults live in tests/model_registry.py
#
# Privatemode additionally needs a locally running proxy; without it its live
# tests skip:
#
#     docker run -p 8080:8080 \
#       ghcr.io/edgelesssys/privatemode/privatemode-proxy:latest --apiKey <key>
#
# See tests/INTEGRATION_TESTS.md for the full picture.
