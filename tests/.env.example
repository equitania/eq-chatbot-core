# eq_chatbot_core Test Configuration
# Copy this file to .env.test and fill in your test API keys
#
# IMPORTANT: Never commit .env.test to version control!
# The .env.test file is gitignored for security.

# =============================================================================
# Cloud Provider API Keys (for Integration Tests)
# =============================================================================

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# LangDock API Key
# Get yours at: https://app.langdock.com/settings/api-keys
LANGDOCK_API_KEY=ld-...

# Mammouth AI API Key
# Get yours at: https://mammouth.ai
MAMMOUTH_API_KEY=mm-...

# Azure AI API Key and Endpoint
# Get yours at: https://ai.azure.com/
AZURE_API_KEY=...
AZURE_ENDPOINT=https://your-resource.services.ai.azure.com/

# Google Vertex AI (uses Application Default Credentials)
# Auth: gcloud auth application-default login
# Or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=europe-west1

# =============================================================================
# Local LLM Server Configuration
# =============================================================================

# LM Studio URL (default: http://localhost:1234/v1)
# Download LM Studio at: https://lmstudio.ai/
LM_STUDIO_URL=http://localhost:1234/v1

# Ollama URL (default: http://localhost:11434/v1)
# Install Ollama at: https://ollama.ai/
OLLAMA_URL=http://localhost:11434/v1

# =============================================================================
# Test Model Configuration
# =============================================================================

# Use cost-effective models for testing!
# These models have the lowest cost per token.

# OpenAI: gpt-4o-mini is the cheapest option ($0.15/1M input, $0.60/1M output)
OPENAI_TEST_MODEL=gpt-4o-mini

# Anthropic: claude-3-haiku is the cheapest option ($0.25/1M input, $1.25/1M output)
ANTHROPIC_TEST_MODEL=claude-3-haiku-20240307

# LangDock: Uses same models as providers, prefer mini/haiku
LANGDOCK_TEST_MODEL=gpt-5.2

# Mammouth AI: gpt-4.1-nano is the cheapest available model
MAMMOUTH_TEST_MODEL=gpt-4.1-nano

# Azure AI: Use your deployed model name
AZURE_TEST_MODEL=gpt-4o

# Vertex AI: gemini-2.5-flash is cost-effective with EU availability
VERTEX_TEST_MODEL=gemini-2.5-flash

# Local: Use small, fast models
# LM Studio: Download Phi-4-mini (recommended) or similar small model
LOCAL_TEST_MODEL=phi-4-mini

# =============================================================================
# Test Behavior Settings
# =============================================================================

# Skip live API tests (useful for CI without API keys)
# Set to "true" to skip tests that require real API calls
SKIP_LIVE_TESTS=false

# Skip local server tests (set to "true" if no local server is running)
SKIP_LOCAL_TESTS=true

# Maximum tokens for test completions (keep low to reduce costs)
TEST_MAX_TOKENS=20

# Test timeout in seconds
TEST_TIMEOUT=30
