# eq-chatbot configuration file
#
# Location (first match wins):
#   1. $EQ_CHATBOT_CONFIG
#   2. $XDG_CONFIG_HOME/eq-chatbot/config.toml
#   3. ~/.config/eq-chatbot/config.toml
#
# Create it with:  eq-chatbot config init
# Inspect it with: eq-chatbot config show   (keys are masked)
#
# SECURITY: this file holds API keys in plain text. Keep it private:
#   chmod 600 ~/.config/eq-chatbot/config.toml
# eq-chatbot warns if the file is readable by others.
#
# Value precedence the CLI applies (highest first):
#   api_key   : --api-key  >  <PROVIDER>_API_KEY env  >  LLM_API_KEY env  >  this file
#   base_url  : --base-url  >  this file  >  provider built-in default
#   model     : --model     >  this file  >  error (no built-in default)
#   image_model (image, listing-assets): --model  >  recipe  >  this file  >  error
#   provider  : --provider  >  default_provider below
# Remove or comment out anything you do not need — every field is optional.

# Provider used when --provider is omitted (optional).
# One of: openai, anthropic, langdock, openrouter, mammouth, litellm,
#         ionos, melious, privatemode, local, lm_studio, ollama
# default_provider = "melious"

# Global chat defaults (optional); used by `eq-chatbot chat` when the flags are omitted.
[defaults]
# temperature = 0.7
# max_tokens  = 4096

# ─────────────────────────────────────────────────────────────────────────────
# Per-provider settings. For each provider: api_key (required for cloud providers),
# optional base_url (override the built-in endpoint), model (used when --model is not given — there is no built-in default),
# image_model (openai, openrouter: used by `image` and `listing-assets`; kept apart from the chat model).
# ─────────────────────────────────────────────────────────────────────────────

[providers.openai]
# api_key  = "sk-..."
# model    = "your-model-id"
# image_model = "your-image-model"
# base_url = "https://api.openai.com/v1"

[providers.anthropic]
# api_key  = "sk-ant-..."
# model    = "your-model-id"
# base_url = "https://api.anthropic.com"

[providers.langdock]
# api_key  = "..."
# model    = "your-model-id"
# base_url = "https://api.langdock.com"

[providers.openrouter]
# api_key  = "sk-or-..."
# model    = "your-model-id"
# image_model = "vendor/your-image-model"
# base_url = "https://openrouter.ai/api/v1"

[providers.mammouth]
# api_key  = "mm-..."
# model    = "your-model-id"
# base_url = "https://api.mammouth.ai/v1"

[providers.litellm]
# api_key  = "..."
# model    = "your-model-id"
# base_url = "https://your-gateway/v1"   # required for LiteLLM

[providers.ionos]
# IONOS AI Model Hub (EU-hosted).
# api_key  = "..."
# model    = "your-model-id"
# base_url = "https://openai.inference.de-txl.ionos.com/v1"

[providers.melious]
# Melious.ai (sovereign EU-hosted).
# api_key  = "sk-mel-..."
# model    = "your-model-id"
# base_url = "https://api.melious.ai/v1"

[providers.privatemode]
# Privatemode.ai (end-to-end encrypted, confidential computing).
# Requests go to the LOCAL privatemode-proxy, which encrypts and attests for you:
#   docker run -p 8080:8080 ghcr.io/edgelesssys/privatemode/privatemode-proxy:latest --apiKey <key>
# api_key is only needed when the proxy was started WITHOUT --apiKey.
# api_key  = "..."
# model    = "your-model-id"
# base_url = "http://localhost:8080/v1"

# Local providers need no api_key; set base_url only if you changed the default port.
[providers.lm_studio]
# model    = "your-model-id"
# base_url = "http://localhost:1234/v1"

[providers.ollama]
# model    = "your-model-id"
# base_url = "http://localhost:11434/v1"
